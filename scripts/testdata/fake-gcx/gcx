#!/usr/bin/env bash
# Stand-in for gcx in offline tests. Prints $FAKE_GCX_OUTPUT (a file) and exits
# $FAKE_GCX_EXIT (default 0). Copies any -f file to $FAKE_GCX_CAPTURE, any -d
# body to $FAKE_GCX_CAPTURE_DATA, and the arguments to $FAKE_GCX_CAPTURE_ARGS,
# so tests can assert on what the script sent. $FAKE_GCX_LOG gets one line
# per call: GRAFANA_TOKEN, a tab, then the arguments separated by tabs
# (newlines in them logged as \n). For `gcx api` calls, $FAKE_GCX_API_OUTPUT
# and $FAKE_GCX_API_EXIT, when set, take the place of the two above.
set -euo pipefail
if [ "${1:-}" = api ] && [ -n "${FAKE_GCX_API_OUTPUT:-}" ]; then
  FAKE_GCX_OUTPUT="$FAKE_GCX_API_OUTPUT"
  FAKE_GCX_EXIT="${FAKE_GCX_API_EXIT:-0}"
fi
if [ -n "${FAKE_GCX_CAPTURE_ARGS:-}" ]; then
  printf '%s\n' "$@" >"$FAKE_GCX_CAPTURE_ARGS"
fi
if [ -n "${FAKE_GCX_LOG:-}" ]; then
  logged=()
  for arg in "$@"; do logged+=("${arg//$'\n'/\\n}"); done
  (IFS=$'\t'; printf '%s\t%s\n' "${GRAFANA_TOKEN:-}" "${logged[*]}") >>"$FAKE_GCX_LOG"
fi
while [ $# -gt 0 ]; do
  if [ "$1" = "-f" ] && [ -n "${FAKE_GCX_CAPTURE:-}" ]; then
    cp "$2" "$FAKE_GCX_CAPTURE"
  fi
  if [ "$1" = "-d" ] && [ -n "${FAKE_GCX_CAPTURE_DATA:-}" ]; then
    printf '%s' "$2" >"$FAKE_GCX_CAPTURE_DATA"
  fi
  shift
done
if [ -n "${FAKE_GCX_OUTPUT:-}" ]; then
  cat "$FAKE_GCX_OUTPUT"
fi
exit "${FAKE_GCX_EXIT:-0}"
