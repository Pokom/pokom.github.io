#!/usr/bin/env bash
# Stand-in for gh in offline tests. Appends each call's arguments (one line,
# space-joined) to $FAKE_GH_LOG. A GET of a comments list prints
# $FAKE_GH_COMMENTS (a file, may hold several concatenated JSON arrays like
# --paginate). Writes print "{}". Exits $FAKE_GH_EXIT (default 0).
set -euo pipefail
echo "$*" >>"${FAKE_GH_LOG:-/dev/null}"
method=GET
prev=""
for a in "$@"; do
  if [ "$prev" = "-X" ]; then method="$a"; fi
  if [ "$prev" = "-F" ] && [ -n "${FAKE_GH_BODY_CAPTURE:-}" ]; then
    # -F body=@file → copy the file the script asked gh to send.
    cp "${a#body=@}" "$FAKE_GH_BODY_CAPTURE"
  fi
  prev="$a"
done
if [ "${FAKE_GH_EXIT:-0}" != 0 ]; then
  echo "gh: simulated failure" >&2
  exit "$FAKE_GH_EXIT"
fi
if [ "$method" = GET ]; then
  cat "${FAKE_GH_COMMENTS:-/dev/null}"
else
  echo "{}"
fi
